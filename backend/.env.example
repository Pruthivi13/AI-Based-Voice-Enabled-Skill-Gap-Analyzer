# ─── Server ───
PORT=3001
NODE_ENV=development

# ─── Database (Supabase PostgreSQL) ───
# Use the pooled connection string (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Use the direct connection string (port 5432) for DIRECT_URL (used by Prisma Migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Frontend ───
FRONTEND_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000

# ─── Supabase ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Firebase ───
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── AI Services ───
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_LLM_MODEL=llama-3.1-8b-instant
LLM_PROVIDER_ORDER=gemini,groq
LLM_PROVIDER_TIMEOUT_SECONDS=20
SERPER_API_KEY=your_serper_api_key_here

# ─── Whisper STT ───
WHISPER_MODEL_SIZE=base
STT_PROVIDER=local

# ─── Content Scorer ───
# Use SentenceTransformer semantic similarity unless fine-tuned weights exist.
CONTENT_SCORER_BACKEND=semantic
# CONTENT_SCORER_MODEL_PATH=/absolute/path/to/interview_content_model_binary
